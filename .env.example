# Copy this file to ".env" and fill in the values from YOUR OWN Supabase project
# (Supabase dashboard -> Project Settings -> API)

# --- From your own Supabase project ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Same values again without the VITE_ prefix (used by server-side code)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Service role key (server-side only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
